# 複製成 .env 並填入自己的值；.env 已在 .gitignore 中，不會被提交
# MySQL（import_100.py、sql_model_comparison.py、update_model_architecture_fields.py 使用）
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=testdb

# Hugging Face token（import_100.py 下載 gated 模型時使用；只處理公開模型可留空）
# 到 https://huggingface.co/settings/tokens 建立
HF_TOKEN=
